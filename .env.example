# Only configure real values in local environment or Vercel settings.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Generate a random secret for each environment (at least 32 bytes).
AUTH_SECRET=
# Production origin, e.g. https://precifica.example.com
AUTH_URL=
# Configure only the chosen OAuth provider.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated stable identities, e.g. github:123456
AUTH_ALLOWED_IDS=
# Optional: explicitly authorized, verified Google email addresses.
AUTH_ALLOWED_GOOGLE_EMAILS=
